# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (for API keys stored in DB)
ENCRYPTION_KEY=generate-a-32-byte-hex-key

# Vercel Cron (secret for authenticating cron job requests)
CRON_SECRET=generate-a-random-secret-string

# Paddle (billing)
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_TEAM_PRICE_ID=pri_...
# One-time price for the "LLMeter Live Cost" browser-extension lifetime license.
# Leave unset until the price exists in Paddle; the webhook ignores LTD events otherwise.
NEXT_PUBLIC_PADDLE_EXT_LTD_PRICE_ID=pri_...
# Chrome Web Store listing URL for the extension; "Install free" is disabled until set.
NEXT_PUBLIC_EXT_STORE_URL=https://chromewebstore.google.com/detail/...

# Upstash Redis (distributed rate limiting — optional for local dev)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Resend (Email — required for budget alert notifications)
# 1. Get an API key at https://resend.com/api-keys
# 2. Verify your sending domain at https://resend.com/domains (DNS records)
# 3. Set EMAIL_FROM to an address on that verified domain
# For testing without a verified domain, use: LLMeter <onboarding@resend.dev>
RESEND_API_KEY=re_...
EMAIL_FROM=LLMeter <alerts@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E Testing
E2E_TEST_EMAIL=your-test-email@example.com
E2E_TEST_PASSWORD=your-test-password

# Weekly product report (cron, Mondays 12:00 UTC)
WEEKLY_REPORT_TO=you@example.com
EXT_PUBLISHED_AT=            # ISO date the extension went live in the Chrome Web Store
EXT_INSTALLS=                # optional manual install count from the Web Store dashboard
